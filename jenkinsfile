pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/YashChandiramani/GitHub-Trail/blob/main/jenkinsfile'
            }
        }

        stage('Check Node.js') {
            steps {
                bat 'node --version'
            }
        }

        stage('Run Registration Tests') {
            steps {
                bat 'node test2.js'
            }
        }
    }
}